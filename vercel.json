{
  "functions": {
    "api/landbooks/[id]/refresh.js": {
      "maxDuration": 300
    }
  },
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/odemira",
      "destination": "/region"
    },
    {
      "source": "/lima",
      "destination": "/region"
    },
    {
      "source": "/report/:slug",
      "destination": "/api/report/:slug"
    }
  ],
  "redirects": [
    {
      "source": "/wiki",
      "destination": "/odemira",
      "permanent": true
    }
  ]
}
