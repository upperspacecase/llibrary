{
  "functions": {
    "api/reports/generate.js": {
      "maxDuration": 120
    }
  },
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/wiki/:section",
      "destination": "/wiki.html"
    },
    {
      "source": "/report/:slug",
      "destination": "/api/report/:slug"
    }
  ]
}