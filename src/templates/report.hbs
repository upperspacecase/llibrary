{{!-- 16 — What to Do Next (Actions)                                         --}}
{{!-- ═══════════════════════════════════════════════════════════════════════ --}}

<main class="a4-container">
  {{> section-header title="What to Do Next"}}

  <section class="grid grid-cols-1 md:grid-cols-[1.5fr_1fr] gap-12 mb-12">
    <div class="space-y-8">
      <p class="drop-cap text-[14.6px] leading-relaxed text-on-surface">{{actions.recommendation}}</p>
    </div>
    <div class="flex flex-col justify-start pt-4">
      <div class="flex justify-end">
        <blockquote class="max-w-[320px] border-l-4 border-brand-terracotta pl-6 py-2">
          <p class="serif-title text-xl text-brand-forest leading-relaxed">Strategic action plan</p>
        </blockquote>
      </div>
    </div>
  </section>

  <div class="hairline"></div>

  {{#if actions.immediate.length}}
  <div class="py-8">
    <span class="text-[10px] font-black tracking-[0.2em] text-brand-terracotta uppercase block mb-3">Immediate Actions</span>
    {{#each actions.immediate}}
    <div class="mb-4">
      <p class="text-brand-forest font-medium leading-relaxed">{{fmt this.title}}</p>
    </div>
    {{/each}}
  </div>
  <div class="hairline"></div>
  {{/if}}

  {{#if actions.shortTerm.length}}
  <div class="py-8">
    <span class="text-[10px] font-black tracking-[0.2em] text-brand-terracotta uppercase block mb-3">Short-Term Actions</span>
    {{#each actions.shortTerm}}
    <div class="mb-4">
      <p class="text-brand-forest font-medium leading-relaxed">{{fmt this.title}}</p>
    </div>
    {{/each}}
  </div>
  <div class="hairline"></div>
  {{/if}}

  {{#if actions.longTerm.length}}
  <div class="py-8">
    <span class="text-[10px] font-black tracking-[0.2em] text-brand-terracotta uppercase block mb-3">Long-Term Actions</span>
    {{#each actions.longTerm}}
    <div class="mb-4">
      <p class="text-brand-forest font-medium leading-relaxed">{{fmt this.title}}</p>
    </div>
    {{/each}}
  </div>
  <div class="hairline"></div>
  {{/if}}

  {{> section-footer label="Action Plan"}}
</main>

{{!-- ═══════════════════════════════════════════════════════════════════════ --}}
{{!-- 17 — Methodology, Sources & Disclaimer                                --}}
{{!-- ═══════════════════════════════════════════════════════════════════════ --}}

<main class="a4-container">
  {{> section-header title="Methodology, Sources & Disclaimer"}}

  <section class="grid grid-cols-1 md:grid-cols-[1.5fr_1fr] gap-12 mb-12">
    <div class="space-y-8">
      <p class="drop-cap text-[14.6px] leading-relaxed text-on-surface">{{methodology.text}}</p>
    </div>
    <div class="flex flex-col justify-start pt-4">
    </div>
  </section>

  <div class="hairline"></div>

  <div class="py-4">
    <table class="w-full text-left">
      <thead>
        <tr class="border-b-[0.5px] border-brand-sage">
          <th class="py-3 text-[10px] font-bold tracking-widest text-brand-sage uppercase">Source</th>
          <th class="py-3 text-[10px] font-bold tracking-widest text-brand-sage uppercase">Description</th>
        </tr>
      </thead>
      <tbody class="divide-y-[0.5px] divide-brand-sage/20">
        {{#each methodology.sources}}
        <tr>
          <td class="py-4 text-sm font-bold text-brand-forest">{{this.name}}</td>
          <td class="py-4 text-sm text-on-surface">{{this.description}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  <div class="hairline"></div>

  <div class="pt-6 text-center">
    <div class="text-[10px] font-bold tracking-[0.15em] text-brand-forest uppercase">LandBook Natural Capital Assessment</div>
    <div class="text-[12px] italic text-brand-forest mt-2">Generated {{fmt methodology.generatedAt}} &middot; {{fmt methodology.version}}</div>
  </div>

  {{> section-footer label="Methodology & Disclaimer"}}
</main>
