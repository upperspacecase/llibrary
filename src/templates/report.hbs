        </tr>
      </thead>
      <tbody class="divide-y-[0.5px] divide-brand-sage/20">
        <tr><td class="py-4 text-sm font-bold text-brand-forest">Fire</td><td class="py-4 text-sm text-on-surface">{{fmt risks.fire.riskScore "score5"}}</td><td class="py-4 text-right">{{{riskBadge risks.fire.riskLevel}}}</td></tr>
        <tr><td class="py-4 text-sm font-bold text-brand-forest">Flood</td><td class="py-4 text-sm text-on-surface">{{fmt risks.flood.riskScore "score5"}}</td><td class="py-4 text-right">{{{riskBadge risks.flood.riskLevel}}}</td></tr>
        <tr><td class="py-4 text-sm font-bold text-brand-forest">Drought</td><td class="py-4 text-sm text-on-surface">{{fmt risks.drought.riskScore "score5"}}</td><td class="py-4 text-right">{{{riskBadge risks.drought.riskLevel}}}</td></tr>
